rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isActiveUser() {
      return isAuthenticated() && request.auth.token.status == 'ACTIVE';
    }
    
    function isAdmin() {
      return isActiveUser() && getUserRole() == 'ADMIN';
    }
    
    function isGestor() {
      return isActiveUser() && (getUserRole() == 'GESTOR' || getUserRole() == 'ADMIN');
    }
    
    function isTecnico() {
      return isActiveUser() && (getUserRole() == 'TECNICO' || getUserRole() == 'GESTOR' || getUserRole() == 'ADMIN');
    }

    // User profiles & roles
    match /users/{userId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Presence and real-time collaboration
    match /presence/{proposalId}/users/{userId} {
      allow read, write: if isActiveUser();
    }

    // Real-time activity notifications
    match /notifications/{notificationId} {
      allow read: if isActiveUser() && request.auth.uid == resource.data.userId;
      allow write: if isTecnico();
    }

    // Audit logs (Read only for Gestor/Admin, Write through backend Cloud Run)
    match /audit_logs/{logId} {
      allow read: if isGestor();
      allow write: if false; // Only backend service account
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
