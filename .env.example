# Google Maps API Key
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web SDK (configuração pública do aplicativo Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (use Application Default Credentials em produção/Google Cloud)
FIREBASE_PROJECT_ID=
FUNDERR_BOOTSTRAP_EMAIL=

# Desenvolvimento local opcional com Firebase Emulator Suite
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Alternativa local às Application Default Credentials. Nunca versionar o valor real.
# FIREBASE_SERVICE_ACCOUNT_JSON={}
