{
  "name": "funderr-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.local --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --production --packages=external --sourcemap=external --outdir=dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate:firestore": "bun --env-file=.env.local scripts/migration/json-to-firestore.ts",
    "firebase:emulators": "bunx firebase-tools emulators:start",
    "firebase:deploy": "bunx firebase-tools deploy --only auth,firestore,storage,remoteconfig"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.1",
    "firebase-admin": "^14.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
