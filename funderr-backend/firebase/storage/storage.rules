rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isActiveUser() {
      return isAuthenticated() && request.auth.token.status == 'ACTIVE';
    }

    match /proposals/{proposalId}/documents/{documentId}/{fileName} {
      // Allow read for active users
      allow read: if isActiveUser();
      
      // Allow upload with constraints (max 25MB, supported mime types)
      allow write: if isActiveUser()
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('image/jpeg') ||
          request.resource.contentType.matches('image/png') ||
          request.resource.contentType.matches('image/webp')
        );
        
      allow delete: if isActiveUser() && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'GESTOR');
    }
  }
}
